# What setup.sh changes in the project .env, relative to .env.example (v0.8.8).
# Everything not listed stays at the example default. The owner changes
# ALLOW_REGISTRATION by hand after creating the first account.

# New keys (not in .env.example). COMPOSE_FILE selects the override without a
# root docker-compose.override.yml; the ZERO_WAN_* values feed override.yml.
COMPOSE_FILE=docker-compose.yml:docs/zero-wan/override.yml
ZERO_WAN_SUBNET=<COMPOSE_SUBNET from zero-wan.env>
ZERO_WAN_BRIDGE=<COMPOSE_BRIDGE from zero-wan.env>

# Public origin behind the TLS proxy.
DOMAIN_CLIENT=https://<CHAT_HOST>
DOMAIN_SERVER=https://<CHAT_HOST>

# Uncommented. The api, mongodb and meilisearch containers run as this uid/gid
# so the bind-mounted directories stay owned by the deploying user.
UID=<id -u>
GID=<id -g>

# Uncommented and narrowed. Only the yaml custom endpoint and the agents
# endpoint appear in the model menu.
ENDPOINTS=custom,agents

# Generated once with openssl rand -hex (32, 16, 32, 32, 32 bytes); never
# rewritten on later setup.sh runs.
CREDS_KEY=<64 hex chars>
CREDS_IV=<32 hex chars>
MEILI_MASTER_KEY=<64 hex chars>
JWT_SECRET=<64 hex chars>
JWT_REFRESH_SECRET=<64 hex chars>

# Left as in the example on purpose:
#   ALLOW_REGISTRATION=true          until the owner's account exists, then false
#   HOST=localhost                   compose sets HOST=0.0.0.0 in the container
#   PORT=3080
#   TRUST_PROXY=1                    the TLS proxy is the single hop in front
#   ALLOW_SOCIAL_LOGIN=false
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, GOOGLE_KEY, ASSISTANTS_API_KEY=user_provided
#       never a dummy key: a dummy triggers model-list fetches against the vendor
#   SEARCH=false, MEILI_NO_ANALYTICS=true
#   #ANALYTICS_GTM_ID stays commented; an empty string would still load GTM
#   # CONFIG_PATH, # RAG_API_URL, RUM_*, OTEL_*, LANGFUSE_*, LIBRECHAT_CODE_* stay commented
#   HELP_AND_FAQ_URL=https://librechat.ai is a click-only link
