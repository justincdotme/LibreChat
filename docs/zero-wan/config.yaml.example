# Rendered from config.yaml.example by setup.sh and bind-mounted as
# /app/librechat.yaml. Edit zero-wan.env, not the rendered file.
version: 1.3.17
cache: true

interface:
  runCode: false
  webSearch: false
  fileSearch: false

registration:
  socialLogins: []

speech:
  speechTab:
    speechToText: false
    textToSpeech: false

endpoints:
  agents:
    capabilities: ["artifacts", "context", "tools"]
  custom:
    - name: "@MODEL_LABEL@"
      apiKey: "none"
      baseURL: "@LLAMA_BASE_URL@"
      models:
        default: ["@MODEL_ID@"]
        fetch: false
      titleConvo: true
      titleModel: "current_model"
      modelDisplayLabel: "@MODEL_LABEL@"
